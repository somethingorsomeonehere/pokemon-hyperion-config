# proto-file: HelpArticles.proto
# proto-message: er.HelpArticles

help_category {
  title: "Basic Information"
  color: BLUE
  help_article {
    title: "Talk to Nurse Joy"
    page: "Talk to Nurse Joy in any Pokemon Center to\nreceive a DexNav+, Infinite Repel, Battle\nItems, all Pokeballs, all Berries, all\nType Gems, and more.\n\nEach time you speak to her, all items\nare refilled.\n\nMega Stones are the only items not given"
    page: "by Nurse Joy."
  }
  help_article {
    title: "Online Pokedex"
    page: "https://dex.elite-redux.com\n\nThe Online Dex shows all info on Pokemon,\nAbilities, Moves, Locations, and Trainers.\n\nYou can also build teams there for\ntheorycrafting."
  }
  help_article {
    title: "Pokemon Changes"
    page: "Almost every Pokemon has been improved for\nbetter balance and utility.\n\nNotable reworks:\nKecleon: Colour Change activates before an\nattack hits. It changes Kecleon's type to\nthe most favourable matchup. This makes it\nimmune to attacks with a type-based\nimmunity and resistant to all other attacks."
    page: "\nEeveelutions: All can devolve to Eevee,\npreserving movepools. All eight share\nmovepools, gaining unparalleled type\ncoverage and varied STAB moves.\n\nHatterene: Innate Pixilate, Magic Bounce,\nand Hyper Aggressive (Parental Bond clone).\nAbility Twisted Dimensions sets Trick Room"
    page: "for 3 turns on entry.\n\nDewgong: Abilities: Fur Coat, Ice Scales,\nArctic Fur (lesser version of both).\nInnate North Wind auto-sets Aurora Veil\nfor 3 turns on entry.\n\nGliscor: Has Poison Heal. Gets Rough Skin\nfor better physical defense. Tectonize"
    page: "ability turns Facade into Ground-type.\n\nPyukumuku: 600 BST, innate Unaware.\nPressure (buffed: casts Haze on entry\nand its vanilla function).\n\nBraviary: Stacks Defiant, Flock (Flying\nOvergrow), buffed Big Pecks. Can have\nGiant Wings or Gale Wings for immense power."
    page: "\nPhione: Innate High Tide: uses 50BP Surf\nafter any Water move. Field Explorer\nempowers 'field' moves (Headbutt, Surf).\nSoul-Heart ability option.\n\nCheck the Online Pokedex for details."
  }
  help_article {
    title: "Move Changes"
    page: "Many moves have improved accuracy and power.\n\nOHKO moves (e.g. Fissure) now deal around 120\ndamage with 80% accuracy.\n\nSome moves have new effects; others are\ncompletely reworked. Most moves have a\nusable niche.\n"
    page: "Further details are in the Online Pokedex."
  }
  help_article {
    title: "Quality of Life Improvements"
    page: "Portable PC: Access from Start Menu\n(disabled for Elite Four).\n\nNo need to teach HMs. Fly to any visited\nlocation with any Pokemon. Other HMs\nunlock as you complete Gyms.\n\nRegister multiple items for easy access\nusing L button."
  }
  help_article {
    title: "Battle Changes"
    page: "All Pokemon now have 31 IVs by default.\nUse Iron Pill to set Speed to 0 if needed\n(and back to 31).\n\nAce/Elite Modes include Sleep Clause (only\none enemy Pokemon can be put to sleep).\n\nAll moves have PP Max. Held items regen\nafter battles. Pokemon heal after most"
    page: "battles. Some are gauntlets (no healing)."
  }
  help_article {
    title: "Battle UI Changes"
    page: "Press L during battles for this wiki.\nShortcut changeable in Settings > Custom (R).\n\nSee a move's effectiveness before use.\nThis considers abilities/innates like\nLevitate or Sap Sipper!\n\nSTAB (50% Same Type Attack Bonus) is\nshown with a + icon."
    page: "\nTrainer battles can be forfeited (counts\nas a loss), returning to last Poke Center."
  }
  help_article {
    title: "Acquiring Pokemon"
    page: "Get one of each Pokeball from Nurse Joy, all with 100% catch rate. Pokeballs are not consumed on use.\n\nUpgraded DexNav+ auto-searches Pokemon in an area.\n\nShiny rates boostable to 1/5 in Options."
    page: "All Gen 1-9 Pokemon are available.\n\nBuy Redux Pokemon for BP in Adoption Center (more unlock with progress)."
  }
  help_article {
    title: "Switching Nature"
    page: "Switch a Pokemons nature directly in its\nSummary Screen.\n\nNatures increase one base stat by 10%\nand decrease another by 10%.\n\nIndicated by up/down arrows on summary\nscreen next to affected stats."
  }
  help_article {
    title: "Changing Hidden/Secret Power"
    page: "Use Type Gems (from Nurse Joy) to change\na Pokemons Hidden Power type and\nSecret Power (physical version) type."
  }
  help_article {
    title: "Setting EVs"
    page: "Directly assign EVs in Summary Screen;\nno grinding needed.\n\nEach stat: up to 252 EVs. Total: 510 EVs.\n\nTypically, distribute 252 EVs into two\nbest stats for optimal results.\n\nHP is often more useful than one defense,"
    page: "unless base HP is very high and defenses\nare much lower."
  }
  help_article {
    title: "Learning Moves"
    page: "Learn new moves easily in Party or Move\nmenu (press R).\n\nCertain moves still require leveling up.\nThese are in the Level list. Other lists\nshow moves by category.\n\nUnlock new moves after each gym in Elite\ncaps, until about 2/3s into game. Some learn"
    page: "moves faster/slower."
  }
  help_article {
    title: "Evolutions"
    page: "Unusual evolutions are now level-based.\nSummary screen shows if a Pokemon can\nevolve and at what level.\n\nPotential Mega Evolutions also shown on\nSummary screen (even without the stone),\nbut unusable without it.\n\nEvolve from Party menu; choose evolution"
    page: "for branched paths.\n\nLevel up from Party menu. Level Caps and\nscaling enemies prevent overleveling."
  }
}
help_category {
  title: "Ability Information"
  color: GREEN
  help_article {
    title: "Innates"
    page: "Pokemon have 1-3 abilities, changeable\nin summary menu. Most have 3 choices.\nView ability details by selecting them.\n\nPokemon also have 3 'innates' tied to\ntheir species, always active with ability.\n\nOn higher difficulties, most innates are\nlocked. Defeat Gym Leaders and raise"
    page: "level cap to unlock them."
  }
  help_article {
    title: "New Abilities"
    page: "Elite Redux has 500+ new abilities.\n\nSome are for specific Pokemon to make\nthem stronger/more interesting. Some are\ncombo abilities, some new generic ones.\n\nExamples: Chloroplast (moves act as if\nin Sun); Phantom Pain (Ghost moves hit\nNormal); Fungal Infection (contact moves"
    page: "inflict Leech Seed); Fort Knox (blocks\nenemy offensive power-up abilities)."
  }
  help_article {
    title: "Changed Abilities"
    page: "Many existing abilities revised to be\nmore powerful and have a niche.\n\nStall: 30% less damage if not moved.\nBattle/Shell Armour: 20% less damage,\nblock crits.\nBig Pecks: Now a Tough Claws clone.\n\nStorm Drain/Lightning Rod: Boost higher"
    page: "offensive stat on activation.\nFrisk: Disables enemy item for 2 turns."
  }
}
help_category {
  title: "Battle Information"
  color: RED
  help_article {
    title: "General Information about Status Effects"
    page: "Elite Redux changes some effects like\nConfusion and Infatuation, and adds new\nones: Bleed, Fear, Frostbite (replaces\nFreeze)."
  }
  help_article {
    title: "Burn, Paralysis, Poison, Sleep"
    page: "These statuses are unchanged.\n\nBurn: 1/8 HP damage/turn, halves phys. atk.\n\nParalysis: Reduces Speed, 25% chance to\nbe unable to move.\n\nPoison: 1/8 HP damage/turn. Badly Poisoned\nstarts 1/16, increases by 1/16 each turn."
    page: "\nSleep: Unable to move."
  }
  help_article {
    title: "New Status Effects"
    page: "Bleed\n  A unique, non-volatile status effect.\n  Mainly from Keen Edge boosted moves, but\n  not exclusive to them.\n\n  Deals 1/16 max HP damage per turn.\n  Prevents healing effects and negates\n  stat boosts. Rock and Ghost-types immune.\n"
    page: "  Healing moves cure Bleed but won't heal\n  HP that turn.\n\nFear\n  Traps the target for 2 turns.\n  Inflicted Pokemon take 50% more damage.\n\n  Moves: Scary Face, Terror Charge,\n  Worry Seed."
    page: "Frostbite (replaces Freeze)\n  Deals 1/16 HP damage per turn to non-Ice\n  types. Halves user's special atk damage.\n\nEnraged\n  Takes 33% of damage it deals as recoil.\n  Stacks with other sources of recoil."
  }
  help_article {
    title: "Changed Status Effects"
    page: "Infatuation\n  Infatuated targets deal 50%\n  less damage (physical and special).\n  Not affected by gender."
  }
  help_article {
    title: "General Weather Information"
    page: "Weather from moves/abilities: 8 turns\n(12 with Weather Rocks).\n\nHail/Snow\n  Boosts Ice-types Defense by 50%.\n  Damages non-Ice types (1/16 HP/turn).\n  Blizzard ignores accuracy checks.\n\nSandstorm"
    page: "  Damages non-Rock/Ground/Steel types\n  (1/16 HP/turn).\n  Boosts Rock-types Sp. Def by 50%.\n\nRain\n  Boosts Water-type moves by 50%.\n  Weakens Fire-type moves by 50%.\n  Thunder and Hurricane ignore accuracy.\n"
    page: "Sunlight\n  Boosts Fire-type moves by 50%.\n  Weakens Water-type moves by 50%.\n  Prevents freezing.\n  Solar Beam/Blade become 1-turn moves.\n  Growth: Atk and Sp. Atk +2 stages.\n\nHarsh Sunlight\n  Boosts Fire moves, nullifies Water moves."
    page: "\nHeavy Rain\n  Boosts Water moves, nullifies Fire moves.\n\nStrong Winds\n  Reduces super-effective damage vs Flying\n  types to neutral."
  }
  help_article {
    title: "New Weather: Fog"
    page: "Elite Redux reintroduces Fog as unique\nweather: Eerie Fog. Effects:\n\n- Drains non-Ghost/Psychic +stats by 1\n  stage each turn.\n- Halves weather-based recovery (Synthesis).\n- 20% damage reduction for Ghost/Psychic.\n\n- Revival Blessing fails."
    page: "- Harvest fails.\n- All Curse instances become Ghost-type.\n\n- Weather Ball becomes Ghost, 2x power.\n- Castform (Foggy) form.\n- Some moves like Ominous Wind 2x power.\n\nSmoke Ball (held item) increases fog\nduration from 8 to 12 turns."
  }
}
help_category {
  title: "Miscellaneous Information"
  color: YELLOW
  help_article {
    title: "Permanent Mega Mode"
    page: "Unlocked after talking to Norman.\n\nChange Pokemon to Mega forms o/s battle\nvia party menu (like normal form change).\nStill requires correct Mega Stone in bag.\n\nPokemon stays Mega after battles.\nAllows multiple Megas on a team at once.\nMegas can hold other items!"
    page: "\nNormal in-battle Mega Evolution is still\nan option."
  }
  help_article {
    title: "Special Mega Stones Locations"
    page: "Most new M.Stones: Adoption Center post-\nNorman (few exceptions).\n\nNorman gives vanilla M.Stones, Primal Orbs,\nand some new Megas (most starters).\n\nSome spread on map: M.Lapras X in\nSlateport Museum (top). M.Shuckle at\nstart of Cycling Rd (N. of Slateport)."
    page: "\nSinnoh starter M.Stones: Game Corner.\n\nJohto starter M.Stones:\n- M.Typhlosion: Ashen Woods (top right),\n  defeat Kindler.\n- M.Meganium: Verdanturf Meadow, defeat\n  Aroma Lady.\n- M.Feraligatr X: Rte 105 (beach),"
    page: "  defeat Sailor.\n- M.Feraligatr Y: Rte 114, Totem.\n\nNew Totem fights grant M.Stones:\n- M.Breloom: N. Petalburg Forest (New Area).\n- M.Sandslash: S. of Rte 111 (desert).\n- M.Haxorus: Meteor Falls (trainer guards\n  new zone opening).\n- M.Dewgong: Seaspray Cave (2F)."
    page: "- M.Gyarados Y: Rte 132.\n\nSpecial Event M.Stones:\n- M.Lanturn: From Wattson (his quest).\n- M.Slaking: From Norman (post-Winona).\n- M.Toucannon: From Winona (her badge).\n- M.Slowking: From Tate and Liza (badge).\n\nTough Opponent M.Stones (examples):"
    page: "- M.Krookodile: Defeat Ruin Maniac\n  (o/s Mirage Tower extra zone).\n\n- M.Nidoking/Queen: o/s Rusturf Tunnel\n  (Rte 116), defeat Ace Trainer.\n- Hitmon M.Stones (all 3): Granite Cave\n  (B2F) defeat Black Belt (1 Fighting-type;\n  he uses one Hitmon-Mega randomly).\n- M.Dragonite: Sky Pillar (beat gauntlet)."
  }
  help_article {
    title: "Primal Forms"
    page: "Five new Primal Forms for existing Pokemon.\nGet items from Ace Trainer by your house:\n- Tera Orb (Stellar Terapagos)\n- Eternamax Orb (Eternamax Eternatus)\n- Ultra Necrozmite (Ultra Necrozma)\n- Crowned Sword (Zacian Crowned)\n- Crowned Shield (Zamazenta Crowned)\n(Crowned forms are now Primal Forms.)\n"
    page: "Nurse Joy (first talk) gives Lustrous,\nAdamant, Griseous Orbs. These allow the\nDialga, Palkia, Giratina trio to turn to\nOrigin Formes (stats 680 -> 780 BST).\n\nPrimal Cascoon: Deep in Petalburg Woods,\nacross a surf spot."
  }
  help_article {
    title: "Where to get the other starters?"
    page: "Get 2nd starter (random) after beating\nCalvin on Rte 102.\n\nAfter beating Flannery, other starters\nare available around Hoenn:\n- Fire types: Shop in Lavaridge.\n\n- Grass types: Flower Shop o/s Petalburg\n  Woods."
    page: "- Water types: Open-Air Market, Slateport.\n\nNote: If far in game, get all from\nLilycove Department Store."
  }
}